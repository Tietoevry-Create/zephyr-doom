mainmenu "Zephyr Kernel Configuration"

source "Kconfig.zephyr"

module = DOOM_MAIN
module-str = doom_main
source "subsys/logging/Kconfig.template.log_config"

menu "Zephyr Doom features"

config FEATURE_DOOM_AUDIO
	bool "Audio (I2S mixer output)"
	default y if BOARD_NRF5340DK_NRF5340_CPUAPP || BOARD_FRDM_MCXN947 || BOARD_FRDM_MCXN947_MCXN947_CPU0
	select I2S
	select I2S_MCUX_SAI if BOARD_FRDM_MCXN947 || BOARD_FRDM_MCXN947_MCXN947_CPU0
	help
	  Enable Doom audio output.

config FEATURE_DOOM_BLE
	bool "BLE input (HID clients via NCS helpers)"
	default y if BOARD_NRF5340DK_NRF5340_CPUAPP
	default n
	select BT
	select BT_CENTRAL
	select BT_SMP
	select BT_GATT_CLIENT
	select BT_SCAN
	select DK_LIBRARY if SOC_NRF5340_CPUAPP
	select BT_GATT_DM if SOC_NRF5340_CPUAPP
	select BT_HOGP if SOC_NRF5340_CPUAPP
	select BT_SCAN_FILTER_ENABLE if SOC_NRF5340_CPUAPP
	help
	  Enable BLE-based controllers.

	  Note (nRF5340 + NCS): you may also need NCS-specific bt_scan tuning
	  symbols (e.g. CONFIG_BT_SCAN_UUID_CNT).

config FEATURE_DOOM_SD
	bool "SD card upload (copy WAD to external flash)"
	default n
	select DISK_DRIVERS
	select FILE_SYSTEM
	select DISK_ACCESS
	select FAT_FILESYSTEM_ELM
	help
	  Enable mounting an SD card and uploading a WAD into external flash.
	  Normal gameplay reads the WAD from external flash/XIP and does not
	  require this feature.

config FEATURE_DOOM_DISPLAY
	bool "Display output (FT810 over SPI)"
	default y if BOARD_NRF5340DK_NRF5340_CPUAPP || BOARD_FRDM_MCXN947 || BOARD_FRDM_MCXN947_MCXN947_CPU0
	select SPI
	select GPIO
	help
	  Enable FT810 display output. If disabled, Doom still renders internally
	  but no frames are sent to the display controller.

config FEATURE_DOOM_BUTTONS
	bool "GPIO buttons"
	default y if BOARD_NRF5340DK_NRF5340_CPUAPP || BOARD_FRDM_MCXN947 || BOARD_FRDM_MCXN947_MCXN947_CPU0
	depends on GPIO
	help
	  Enable GPIO button input via devicetree aliases sw0..sw3.

config FEATURE_DOOM_LEDS
	bool "Status LEDs"
	default y if BOARD_NRF5340DK_NRF5340_CPUAPP || BOARD_FRDM_MCXN947 || BOARD_FRDM_MCXN947_MCXN947_CPU0
	default n
	depends on GPIO
	help
	  Enable optional LED indications.

config FEATURE_DOOM_SHIELD
	bool "Wired joystick shield (ADC + GPIO)"
	default y if BOARD_FRDM_MCXN947 || BOARD_FRDM_MCXN947_MCXN947_CPU0
	depends on GPIO
	help
	  Enable support for a wired joystick + button shield.

	  The joystick axes are read via Zephyr ADC (devicetree io-channels), and
	  the buttons are read via Zephyr GPIO (devicetree aliases).

config FEATURE_DOOM_NET
	bool "Network multiplayer (UDP, Chocolate Doom 3.0.0 compatible)"
	default y if BOARD_NATIVE_SIM
	default n
	select NETWORKING
	select NET_SOCKETS
	help
	  Enable Chocolate Doom 3.0.0 protocol-compatible UDP multiplayer, so the
	  game can join a standard chocolate-server / chocolate-doom session.

	  The transport (net_zephyr.c) uses Zephyr's BSD socket API. On native_sim
	  this is backed by host-offloaded sockets (enable
	  CONFIG_NET_NATIVE_OFFLOADED_SOCKETS in the board config), which needs no
	  host-side network setup. On hardware targets an IP-capable network
	  interface must additionally be configured.

config DOOM_SERVER_ADDR
	string "Multiplayer server address host[:port] (hardware targets)"
	depends on FEATURE_DOOM_NET
	default "192.168.10.1:2342"
	help
	  Hardware targets have no command line, so this is the server the game
	  connects to when an Ethernet link is present at boot (see M_ArgvInit).
	  Dotted-quad IPv4, optionally ":port" (default port 2342). Ignored on
	  native_sim, which takes -connect from the DOOM_ARGS environment variable.

config DOOM_NET_LINK_WAIT_MS
	int "Boot wait (ms) for Ethernet link before choosing SP vs MP"
	depends on FEATURE_DOOM_NET
	default 3000
	help
	  How long to wait at boot for the Ethernet PHY to report carrier. If the
	  link comes up within this window the game joins CONFIG_DOOM_SERVER_ADDR;
	  otherwise it starts single-player. PHY negotiation typically takes
	  ~1.7 s after reset.

choice
	prompt "Feature preset"
	default FEATURE_DOOM_PRESET_CUSTOM
	help
	  Convenience presets that enable a set of features for some tested boards.

config FEATURE_DOOM_PRESET_CUSTOM
	bool "Custom (no preset)"

config FEATURE_DOOM_PRESET_NRF5340DK_NRF5340_CPUAPP
	bool "nrf5340dk_nrf5340_cpuapp"
	select FEATURE_DOOM_DISPLAY
	select FEATURE_DOOM_AUDIO
	select FEATURE_DOOM_BUTTONS
	select FEATURE_DOOM_LEDS
	select FEATURE_DOOM_SD
	select FEATURE_DOOM_BLE

config FEATURE_DOOM_PRESET_FRDM_MCXN947_MCXN947_CPU0
	bool "frdm_mcxn947_mcxn947_cpu0"
	select FEATURE_DOOM_DISPLAY
	select FEATURE_DOOM_AUDIO
	select FEATURE_DOOM_BUTTONS
	select FEATURE_DOOM_LEDS
	select FEATURE_DOOM_SHIELD

endchoice

endmenu
