#include <nxp/mcx/MCXN947VDF-pinctrl.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/mcux-lpadc.h>
#include <zephyr/dt-bindings/gpio/arduino-header-r3.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

&flexcomm1 {
    status = "okay";
};

// Keep SPI DMA enabled for display performance.
// Synchronization in n_display_zephyr_spi.c ensures sync register accesses do not
// overlap with async framebuffer DMA transfers.

/ {
    aliases {
        doom-status-led = &green_led;
        spi4 = &arduino_spi;
        i2s-tx = &sai1;
        doom-joy = &doom_joy;
        doom-shield-fire = &doom_shield_fire;
        doom-shield-use = &doom_shield_use;
        doom-shield-speed = &doom_shield_speed;
        doom-shield-strafe = &doom_shield_strafe;
        doom-shield-mapbtn = &doom_shield_map;
        doom-shield-menu = &doom_shield_menu;
    };

    /*
     * Wired joystick/button shield configuration.
     *
     * Defaults match common "joystick shield" wiring:
     *  - Joystick: A0/A1 routed to LPADC0 channels (adjust if needed)
     *  - Buttons: D2..D7 (active-low with pull-ups)
     */
    doom_joy: doom_joy {
        compatible = "zephyrdoom,joy";
        io-channels = <&lpadc0 0>, <&lpadc0 1>; /* X, Y */
        invert-y;
    };

    doom_shield_keys: doom_shield_keys {
        compatible = "gpio-keys";

        doom_shield_strafe: shield_btn_strafe {
            gpios = <&arduino_header ARDUINO_HEADER_R3_D2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "doom_shield_strafe";
        };

        doom_shield_fire: shield_btn_fire {
            gpios = <&arduino_header ARDUINO_HEADER_R3_D3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "doom_shield_fire";
        };

        doom_shield_use: shield_btn_use {
            gpios = <&arduino_header ARDUINO_HEADER_R3_D4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "doom_shield_use";
        };

        doom_shield_speed: shield_btn_speed {
            gpios = <&arduino_header ARDUINO_HEADER_R3_D5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "doom_shield_speed";
        };

        doom_shield_map: shield_btn_map {
            gpios = <&arduino_header ARDUINO_HEADER_R3_D6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "doom_shield_map";
        };

        doom_shield_menu: shield_btn_menu {
            gpios = <&arduino_header ARDUINO_HEADER_R3_D7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "doom_shield_menu";
        };
    };
};

/*
 * Configure LPADC channels for joystick axes.
 * Arduino A0/A1 route to dedicated ADC0_A0/ADC0_B0 inputs.
 */
&lpadc0 {
    #address-cells = <1>;
    #size-cells = <0>;
    voltage-ref = <2>;

    channel@0 {
        reg = <0>;
        zephyr,resolution = <12>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_EXTERNAL0";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <MCUX_LPADC_CH0A>;
    };

    channel@1 {
        reg = <1>;
        zephyr,resolution = <12>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_EXTERNAL0";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <MCUX_LPADC_CH0B>;
    };
};

&sram0 {
    reg = <0x20000000 0x68000>;
};

&sramg {
    status = "disabled";
};

&sramh {
    status = "disabled";
};

/* I2S audio via SAI1 -> PCM5102/MAX98357-style DAC/amp.
 * SAI1 pins: TXD0=P2_8, TX_BCLK=P1_0, TX_FS=P1_1.
 * Move SAI1 onto dedicated EDMA channels so it does not collide with
 * the display SPI DMA channels used by arduino_spi. */
&sai0 {
    status = "disabled";
};

&sai1 {
    status = "okay";
    pinctrl-0 = <&pinmux_sai1_doom_audio>;
    pinctrl-names = "default";
    dmas = <&edma0 6 101>, <&edma0 7 102>;
    dma-names = "rx", "tx";
    nxp,rx-dma-channel = <6>;
    nxp,tx-dma-channel = <7>;
};

&sc_timer {
    status = "disabled";
};

&flexpwm1_pwm0 {
    status = "disabled";
};

&usdhc0 {
    status = "disabled";
};

&user_button_2 {
    status = "okay";
};

&user_button_3 {
    status = "okay";
};

/* Keep LPSPI on the Arduino SPI pins (SCK/MOSI/MISO), and leave the CS pin
 * under GPIO control (DISPLAY_PIN_CS_N).
 * CS for the FT810 is driven manually as GPIO (DISPLAY_PIN_CS_N). */
&pinctrl {
    pinmux_sai1_doom_audio: pinmux_sai1_doom_audio {
        group0 {
            pinmux = <SAI1_TX_BCLK_PIO1_0>,
                 <SAI1_TX_FS_PIO1_1>,
                 <SAI1_TXD0_PIO2_8>;
            drive-strength = "high";
            slew-rate = "fast";
            input-enable;
        };
    };

    pinmux_flexcomm1_lpspi_no_cs: pinmux_flexcomm1_lpspi_no_cs {
        group0 {
            pinmux = <FC1_P0_PIO0_24>,
                     <FC1_P1_PIO0_25>,
                     <FC1_P2_PIO0_26>;
            slew-rate = "fast";
            drive-strength = "low";
            input-enable;
        };
    };
};

&arduino_spi {
    pinctrl-0 = <&pinmux_flexcomm1_lpspi_no_cs>;
    pinctrl-names = "default";
};
